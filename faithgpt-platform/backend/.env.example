# =====================================================================================
# FaithGPT API — Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# In deployed environments, these are injected via AWS Secrets Manager (see
# /faithgpt-platform/docs/12-security-framework.md §6) — never commit a populated .env.
# =====================================================================================

# --- Core ---------------------------------------------------------------------------
# Runtime environment: development | test | staging | production
NODE_ENV=development
# Port the HTTP server listens on
PORT=3000

# --- Database (Prisma / PostgreSQL 16) -----------------------------------------------
# PostgreSQL connection string used by Prisma Client
DATABASE_URL="postgresql://faithgpt:faithgpt@localhost:5432/faithgpt?schema=public"

# --- Redis (caching, rate limiting, BullMQ) -------------------------------------------
# Redis connection string used for caching, throttler counters, and BullMQ queues
REDIS_URL="redis://localhost:6379"

# --- JWT Auth (docs/10-authentication-system.md) --------------------------------------
# Signing secret for short-lived access tokens (15 min)
JWT_SECRET=changeme_access_token_secret
# Signing secret for long-lived refresh tokens (30 days), distinct from JWT_SECRET
JWT_REFRESH_SECRET=changeme_refresh_token_secret
# Access token time-to-live (e.g. "15m")
JWT_ACCESS_TTL=15m
# Refresh token time-to-live (e.g. "30d")
JWT_REFRESH_TTL=30d

# --- AI Gateway (docs/06 AI Architecture) ---------------------------------------------
# Anthropic API key used by AIGatewayService for all LLM text generation
ANTHROPIC_API_KEY=sk-ant-changeme
# API key for the hosted image/diffusion provider used by Visual Studio
IMAGE_PROVIDER_API_KEY=changeme_image_provider_key

# --- Billing (Subscriptions & Webhooks) -----------------------------------------------
# Stripe secret API key
STRIPE_SECRET_KEY=sk_test_changeme
# Stripe webhook signing secret (verifies Stripe-Signature header)
STRIPE_WEBHOOK_SECRET=whsec_changeme
# Paystack secret key (West Africa billing provider)
PAYSTACK_SECRET_KEY=sk_test_changeme
# Apple In-App Purchase shared secret for App Store Server Notifications
APPLE_IAP_SHARED_SECRET=changeme_apple_shared_secret
# Google Play service account JSON (stringified) for RTDN verification
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={}

# --- Notifications (Push) --------------------------------------------------------------
# Firebase service account JSON (stringified) used for push notification dispatch
FIREBASE_SERVICE_ACCOUNT_JSON={}

# --- Object Storage (S3-compatible, AWS) ------------------------------------------------
# AWS region for S3 and other AWS-managed resources
AWS_REGION=us-east-1
# S3 bucket name for generated images, exports, and other binary artifacts
S3_BUCKET_NAME=faithgpt-media-dev

# --- Observability ------------------------------------------------------------------
# Sentry DSN for error tracking/alerting
SENTRY_DSN=
