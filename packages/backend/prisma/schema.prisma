// Quick Rider GH - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum RiderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  RIDER_EN_ROUTE
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderType {
  PARCEL_DELIVERY
  FOOD_PICKUP
  SHOPPING_ASSISTANCE
  DOCUMENT_DELIVERY
  PERSONAL_ERRAND
}

enum PaymentMethod {
  MTN_MOMO
  TELECEL_CASH
  AIRTELTIGO_MONEY
  VISA
  MASTERCARD
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  EARNING
  WITHDRAWAL
  COMMISSION
  REFUND
  BONUS
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  ORDER_REQUEST
  ORDER_ACCEPTED
  RIDER_ARRIVED
  DELIVERY_COMPLETED
  PAYMENT_CONFIRMED
  ACCOUNT_APPROVED
  ACCOUNT_SUSPENDED
  NEW_MESSAGE
  SOS_ALERT
  GEOFENCE_ALERT
  POOL_MATCH
  BADGE_EARNED
  SUBSCRIPTION_RENEWAL
  MERCHANT_ORDER
  SYSTEM
}

enum BadgeType {
  STREAK_3
  STREAK_7
  STREAK_30
  DELIVERIES_10
  DELIVERIES_50
  DELIVERIES_100
  DELIVERIES_500
  TOP_RATED
  FAST_RIDER
  VETERAN
}

enum PoolStatus {
  OPEN
  MATCHED
  CLOSED
}

enum MerchantStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ReportType {
  RIDER
  CUSTOMER
  ORDER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid())
  email             String?    @unique
  phone             String?    @unique
  passwordHash      String?
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  firstName         String
  lastName          String
  profilePhotoUrl   String?
  fcmToken          String?    // Firebase Cloud Messaging token
  googleId          String?    @unique
  appleId           String?    @unique
  isPhoneVerified   Boolean    @default(false)
  isEmailVerified   Boolean    @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  rider             Rider?
  customerOrders    Order[]        @relation("CustomerOrders")
  savedAddresses    SavedAddress[]
  sentMessages      Message[]      @relation("SentMessages")
  notifications     Notification[]
  givenRatings      Rating[]       @relation("GivenRatings")
  receivedRatings   Rating[]       @relation("ReceivedRatings")
  reports           Report[]       @relation("ReporterReports")
  reportedIn        Report[]       @relation("ReportedReports")
  otpCodes          OtpCode[]
  refreshTokens     RefreshToken[]
  subscription      Subscription?
  merchantProfile   MerchantProfile?
  fraudFlags        FraudFlag[]

  @@map("users")
}

model Rider {
  id                    String             @id @default(uuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                RiderStatus        @default(PENDING)
  availabilityStatus    AvailabilityStatus @default(OFFLINE)
  ghanaCardUrl          String?
  driversLicenseUrl     String?
  motorcyclePhotoUrl    String?
  motorcycleRegUrl      String?
  selfieUrl             String?
  motorcycleMake        String?
  motorcycleModel       String?
  motorcycleColor       String?
  motorcyclePlate       String?
  licenseClass          String?
  licenseNumber         String?
  currentLatitude       Float?
  currentLongitude      Float?
  lastLocationUpdate    DateTime?
  walletBalance         Decimal            @default(0) @db.Decimal(12, 2)
  totalEarnings         Decimal            @default(0) @db.Decimal(12, 2)
  completedDeliveries   Int                @default(0)
  averageRating         Float              @default(0)
  totalRatings          Int                @default(0)
  adminNotes            String?
  approvedAt            DateTime?
  approvedBy            String?
  currentStreak         Int                @default(0)
  longestStreak         Int                @default(0)
  lastDeliveryDate      DateTime?
  totalCarbonSaved      Float              @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relations
  orders                Order[]            @relation("RiderOrders")
  transactions          Transaction[]
  withdrawalRequests    WithdrawalRequest[]
  badges                RiderBadge[]
  fuelExpenses          FuelExpense[]
  schedule              RiderSchedule?

  @@map("riders")
}

model Order {
  id                    String        @id @default(uuid())
  orderNumber           String        @unique @default(cuid())
  customerId            String
  customer              User          @relation("CustomerOrders", fields: [customerId], references: [id])
  riderId               String?
  rider                 Rider?        @relation("RiderOrders", fields: [riderId], references: [id])
  type                  OrderType
  status                OrderStatus   @default(PENDING)
  description           String?
  pickupAddress         String
  pickupLatitude        Float
  pickupLongitude       Float
  pickupContactName     String?
  pickupContactPhone    String?
  destinationAddress    String
  destinationLatitude   Float
  destinationLongitude  Float
  recipientName         String?
  recipientPhone        String?
  distanceKm            Float?
  estimatedDuration     Int?          // minutes
  baseFare              Decimal       @db.Decimal(10, 2)
  distanceFee           Decimal       @db.Decimal(10, 2)
  timeFee               Decimal       @db.Decimal(10, 2)
  platformFee           Decimal       @db.Decimal(10, 2)
  totalAmount           Decimal       @db.Decimal(10, 2)
  paymentMethod         PaymentMethod @default(CASH)
  paymentStatus         PaymentStatus @default(PENDING)
  paymentReference      String?
  specialInstructions   String?
  cancelReason          String?
  cancelledBy           String?
  acceptedAt            DateTime?
  pickedUpAt            DateTime?
  deliveredAt           DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  deliveryPin           String?
  pinVerified           Boolean       @default(false)
  carbonSavedKg         Float?
  etaMinLow             Int?
  etaMinHigh            Int?
  poolId                String?
  stops                 Json?
  isMultiStop           Boolean       @default(false)
  ghanaPostPickup       String?
  ghanaPostDropoff      String?
  geofenceAlerted       Boolean       @default(false)
  fraudScore            Int           @default(0)
  proofImageUrl         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  messages              Message[]
  ratings               Rating[]
  payment               Payment?
  statusHistory         OrderStatusHistory[]
  orderEvents           OrderEvent[]
  trackingLinks         TrackingLink[]
  pool                  DeliveryPool? @relation(fields: [poolId], references: [id])

  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@map("order_status_history")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  providerRef     String?       // payment provider reference
  providerData    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

model Transaction {
  id          String          @id @default(uuid())
  riderId     String
  rider       Rider           @relation(fields: [riderId], references: [id])
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  balance     Decimal         @db.Decimal(10, 2)  // balance after transaction
  orderId     String?
  description String?
  reference   String?         @unique
  createdAt   DateTime        @default(now())

  @@map("transactions")
}

model WithdrawalRequest {
  id              String           @id @default(uuid())
  riderId         String
  rider           Rider            @relation(fields: [riderId], references: [id])
  amount          Decimal          @db.Decimal(10, 2)
  method          PaymentMethod
  accountNumber   String
  accountName     String
  status          WithdrawalStatus @default(PENDING)
  processedAt     DateTime?
  processedBy     String?
  failureReason   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("withdrawal_requests")
}

model SavedAddress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   // Home, Work, etc.
  address     String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("saved_addresses")
}

model Message {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("messages")
}

model Rating {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  raterId     String
  rater       User     @relation("GivenRatings", fields: [raterId], references: [id])
  ratedId     String
  rated       User     @relation("ReceivedRatings", fields: [ratedId], references: [id])
  score       Int      // 1-5
  comment     String?
  createdAt   DateTime @default(now())

  @@unique([orderId, raterId])
  @@map("ratings")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  data        Json?
  isRead      Boolean          @default(false)
  sentAt      DateTime?
  createdAt   DateTime         @default(now())

  @@map("notifications")
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  reporter     User         @relation("ReporterReports", fields: [reporterId], references: [id])
  reportedId   String
  reported     User         @relation("ReportedReports", fields: [reportedId], references: [id])
  type         ReportType
  reason       String
  description  String?
  status       ReportStatus @default(OPEN)
  orderId      String?
  reviewedBy   String?
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("reports")
}

model OtpCode {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  type        String   // phone_verification, email_verification, password_reset
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@map("otp_codes")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("refresh_tokens")
}

model PricingConfig {
  id              String   @id @default(uuid())
  baseFare        Decimal  @db.Decimal(10, 2)  // GHS
  perKmRate       Decimal  @db.Decimal(10, 2)
  perMinuteRate   Decimal  @db.Decimal(10, 2)
  platformFeePercent Decimal @db.Decimal(5, 2) // e.g. 15.00 = 15%
  minimumFare     Decimal  @db.Decimal(10, 2)
  surgeMultiplier Decimal  @db.Decimal(5, 2)   @default(1.0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pricing_configs")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

// ─── Feature Models ───────────────────────────────────────────────────────────

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event     String
  actorId   String?
  actorRole String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("order_events")
}

model TrackingLink {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("tracking_links")
}

model FraudFlag {
  id        String   @id @default(uuid())
  orderId   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  score     Int
  signals   Json
  reviewed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("fraud_flags")
}

model RiderBadge {
  id        String    @id @default(uuid())
  riderId   String
  rider     Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  badge     BadgeType
  awardedAt DateTime  @default(now())

  @@unique([riderId, badge])
  @@map("rider_badges")
}

model FuelExpense {
  id        String   @id @default(uuid())
  riderId   String
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  litres    Float?
  location  String?
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("fuel_expenses")
}

model RiderSchedule {
  id        String   @id @default(uuid())
  riderId   String   @unique
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  schedule  Json
  updatedAt DateTime @updatedAt

  @@map("rider_schedules")
}

model Subscription {
  id               String   @id @default(uuid())
  customerId       String   @unique
  customer         User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan             String
  deliveriesTotal  Int
  deliveriesUsed   Int      @default(0)
  amountPaid       Decimal  @db.Decimal(10, 2)
  startDate        DateTime
  endDate          DateTime
  active           Boolean  @default(true)
  autoRenew        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("subscriptions")
}

model DeliveryPool {
  id          String     @id @default(uuid())
  status      PoolStatus @default(OPEN)
  pickupArea  String
  pickupLat   Float
  pickupLng   Float
  riderId     String?
  maxOrders   Int        @default(2)
  savingsPct  Float      @default(30)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  orders      Order[]

  @@map("delivery_pools")
}

model MerchantProfile {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  businessType String
  address      String
  latitude     Float?
  longitude    Float?
  phone        String?
  logoUrl      String?
  status       MerchantStatus @default(PENDING)
  totalOrders  Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("merchant_profiles")
}

model SosEscalation {
  id                String   @id @default(uuid())
  riderId           String
  latitude          Float?
  longitude         Float?
  acknowledged      Boolean  @default(false)
  acknowledgedBy    String?
  acknowledgedAt    DateTime?
  escalated         Boolean  @default(false)
  escalatedAt       DateTime?
  contactNotified   Boolean  @default(false)
  resolved          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@map("sos_escalations")
}

model EtaSample {
  id           String   @id @default(uuid())
  distanceKm   Float
  hourOfDay    Int
  dayOfWeek    Int
  actualMinutes Int
  orderType    OrderType
  createdAt    DateTime @default(now())

  @@map("eta_samples")
}
